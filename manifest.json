nano extension/manifest.json
{
  "manifest_version": 3,
  "name": "Cerebro",
  "description": "AI-powered research and graph synthesis assistant",
  "version": "0.1.0",
  "permissions": [
    "activeTab",
    "scripting",
    "contextMenus",
    "storage"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "panel.html",
    "default_icon": {
      "48": "icons/48.png",
      "128": "icons/128.png"
    }
  },
  "icons": {
    "48": "icons/48.png",
    "128": "icons/128.png"
  }
}
